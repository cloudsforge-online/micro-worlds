# Every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. `env_file: .env` fan-out — which hands every container the whole estate's
# secrets — is banned, and this file is what makes the alternative possible.
#
# Copy to `.env` for local work. `.env` is gitignored and must stay that way.

# --- required --------------------------------------------------------------------------------

# This service's own database. It reads no other, and CI fails on a second connection string.
WORLDS_DATABASE_URL=postgres://worlds:worlds@127.0.0.1:5432/worlds

# ── SERVING BOTH NETWORKS FROM ONE POD ────────────────────────────────────────
#
# Both OPTIONAL and empty here: a development stack is one network. Set the first
# in the estate, where one pod answers for mainnet and testnet and the gateway
# stamps `CF-Network` on every request. See micro-deploy
# `docs/network-consolidation.md`.
WORLDS_DATABASE_URL_TESTNET=
#
# The network to assume when no `CF-Network` arrives. For `pnpm dev`, which has
# no gateway in front of it. NEVER set in production: it would let a request that
# lost its header be served from a network nobody named.
CF_NETWORK_SINGLE=


# Identity's JWKS and issuer. Token verification is the only thing this service asks identity for.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# HMAC key for event signatures — outbound AND INBOUND.
#
# This is the key that verifies `billing.entitlement.granted` on POST /v1/events. A provisioning
# webhook with no MAC is a free-worlds endpoint: anyone who can reach the port can assert that a
# customer bought a private world and get one raised. At least 32 random characters:
#   openssl rand -base64 32
# Leaving a placeholder here is refused at boot, deliberately. Do not paste one back in.
# `src/env.ts` runs `@cloudsforge/secrets`, which asserts the SHAPE a generated value has and a
# placeholder cannot — base64 or hex, 32 decoded BYTES, an entropy floor — rather than a deny-list
# of exact strings, which could never contain the next placeholder somebody writes. Generate it
# with `openssl rand -base64 48`. There is no CI or NODE_ENV exemption.
OUTBOX_SIGNING_SECRET=

# Every key POST /v1/events will ACCEPT a signature from, comma-separated, newest first.
#
# Optional. Absent means exactly [OUTBOX_SIGNING_SECRET], which is what every deployment does
# today — leave it unset unless a rotation is in progress.
#
# It exists because the estate's outbox secret is ONE key shared by 24 services, and one key cannot
# be rotated by swapping it: whichever end moves first has every delivery between them refused
# until the other catches up, and a bridge that refuses grant events provisions no worlds. So the
# rotation is a window. Add the new key at the FRONT of this list, restart, move the producers to
# it, then remove the old one:
#   OUTBOX_ACCEPT_SECRETS=<the new key>,<the old key>
# Signing is NOT a list and never becomes one; only accepting is.
#
# Every entry faces the same bar as the signing secret — `openssl rand -base64 48`, checked for
# shape rather than length, INCLUDING the outgoing key —
# and listing the same key twice is refused, because a duplicate makes "which key verified this"
# ambiguous and that answer is how you know the rotation is finished.
# OUTBOX_ACCEPT_SECRETS=

# The upstreams. Billing answers what an account owns; the ledger pays rewards.
LEDGER_URL=http://127.0.0.1:4007
BILLING_URL=http://127.0.0.1:4009

# The long-lived credential this service exchanges for the short-lived token it presents to its
# peers. Identity mints for `service:worlds` with the scopes this service needs, and each
# peer checks the one it cares about.
#
# THIS REPLACES WORLDS_SERVICE_TOKEN, which was a TOKEN — and a service token expires in 600
# seconds (SERVICE_TTL_SECONDS, identity/src/tokens.ts:33). It was read once at boot and nothing
# re-minted it, so ten minutes into every deployment every call to a peer started failing. A
# credential does not expire, is revocable, confers nothing by itself, and buys a fresh ten-minute
# token whenever one is needed. The ten minutes is unchanged: rotation IS expiry.
#
# `deploy/scripts/estate-bootstrap.sh` writes it to compose/estate/tokens.env. It begins `cfsc_`;
# if what you have begins `eyJ` it is a token, not a credential, and the service will refuse it.
#
# Technically optional — the image must be able to boot without one so CI can smoke-test /livez —
# but without it no call to a peer succeeds, and /readyz reports `identity-credential` as a hard
# failure so the replica takes no traffic.
WORLDS_IDENTITY_CREDENTIAL=

# --- optional, with the defaults shown ---------------------------------------------------------

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
WORLDS_DATABASE_POOL_MAX=10

# WORLDS_UPSTREAM_DEADLINE_MS=5000

# Longer than the other upstreams, deliberately: provisioning a world writes up to four thousand
# tile rows in the title service, and a deadline shorter than that work turns every provision into
# a retry of something that succeeded.
# WORLDS_TITLE_DEADLINE_MS=20000

# Provisioning can be paused without pausing the service. Nothing is lost while it is off: the
# `provisions` rows sit `pending` and the sweep drains them when it is turned back on.
# WORLDS_PROVISIONING_ENABLED=true

# The reward budget a new season is opened with when nobody names one, in minor units of the asset
# this service grants in — today that is still SHARD, which the estate has retired and is draining,
# so the number is a ceiling on a wind-down rather than a stake in a live currency. The variable
# keeps its name because it is set on the estate and renaming it would silently uncap every season
# that reads it; the rename belongs with the grant asset itself.
#
# **A MONEY CONTROL, NOT A TUNING KNOB.** Rewards are ledger postings, so a game exploit that mints
# rewards is a money incident. The cap is enforced by the database in the same transaction as the
# posting, so no amount of application-level cleverness can spend past it. Deliberately small: a
# budget nobody chose should bind long before it costs anything. The service this supersedes has no
# cap of any kind.
# WORLDS_SEASON_REWARD_BUDGET_SHARDS=100000

# Names this replica in jobs.locked_by and in provisions.lease_owner. Defaults to the hostname,
# which is the container id under compose and the pod name under Kubernetes.
# INSTANCE_ID=

# The image tag, reported on every log line and in the release manifest.
# CLOUDSFORGE_TAG=dev

# --- not read by this service ------------------------------------------------------------------
#
# OTEL_EXPORTER_OTLP_ENDPOINT and the rest of OTEL_* are read by the OpenTelemetry SDK loaded ahead
# of the process, not by src/env.ts. They belong in the deploy, not here.
#
# A TITLE's service URL is NOT here. It is a column on the `titles` row, because there is more than
# one title — which is the entire point of this service.
#
# WORLDS_TEST_DATABASE_URL is read only by the test suite, and only when its name contains "test" —
# the database-backed tests truncate.
