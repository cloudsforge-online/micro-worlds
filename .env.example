# Every variable this service reads, and nothing else.
#
# Rule 9 of docs/ecosystem/03 §2: a repository declares the variables it needs and the deploy
# provides exactly those. `env_file: .env` fan-out — which hands every container the whole estate's
# secrets — is banned, and this file is what makes the alternative possible.
#
# Copy to `.env` for local work. `.env` is gitignored and must stay that way.

# --- required --------------------------------------------------------------------------------

# This service's own database. It reads no other, and CI fails on a second connection string.
WORLDS_DATABASE_URL=postgres://worlds:worlds@127.0.0.1:5432/worlds

# Identity's JWKS and issuer. Token verification is the only thing this service asks identity for.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# HMAC key for event signatures — outbound AND INBOUND.
#
# This is the key that verifies `billing.entitlement.granted` on POST /v1/events. A provisioning
# webhook with no MAC is a free-worlds endpoint: anyone who can reach the port can assert that a
# customer bought a private world and get one raised. At least 32 random characters:
#   openssl rand -base64 32
# Leaving a placeholder here is refused at boot, deliberately. Do not paste one back in.
OUTBOX_SIGNING_SECRET=

# The upstreams. Billing answers what an account owns; the ledger pays rewards.
LEDGER_URL=http://127.0.0.1:4007
BILLING_URL=http://127.0.0.1:4009

# This service's own scoped credential. NOT shared with any other service — SD-05.
# It must carry: billing:read, ledger:post. It is also the credential a TITLE service sees on a
# provisioning call, so a title can and must check it.
WORLDS_SERVICE_TOKEN=

# --- optional, with the defaults shown ---------------------------------------------------------

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
WORLDS_DATABASE_POOL_MAX=10

# WORLDS_UPSTREAM_DEADLINE_MS=5000

# Longer than the other upstreams, deliberately: provisioning a world writes up to four thousand
# tile rows in the title service, and a deadline shorter than that work turns every provision into
# a retry of something that succeeded.
# WORLDS_TITLE_DEADLINE_MS=20000

# Provisioning can be paused without pausing the service. Nothing is lost while it is off: the
# `provisions` rows sit `pending` and the sweep drains them when it is turned back on.
# WORLDS_PROVISIONING_ENABLED=true

# The reward budget a new season is opened with when nobody names one, in Shards.
#
# **A MONEY CONTROL, NOT A TUNING KNOB.** Rewards are ledger postings, so a game exploit that mints
# rewards is a money incident. The cap is enforced by the database in the same transaction as the
# posting, so no amount of application-level cleverness can spend past it. Deliberately small: a
# budget nobody chose should bind long before it costs anything. The service this supersedes has no
# cap of any kind.
# WORLDS_SEASON_REWARD_BUDGET_SHARDS=100000

# Names this replica in jobs.locked_by and in provisions.lease_owner. Defaults to the hostname,
# which is the container id under compose and the pod name under Kubernetes.
# INSTANCE_ID=

# The image tag, reported on every log line and in the release manifest.
# CLOUDSFORGE_TAG=dev

# --- not read by this service ------------------------------------------------------------------
#
# OTEL_EXPORTER_OTLP_ENDPOINT and the rest of OTEL_* are read by the OpenTelemetry SDK loaded ahead
# of the process, not by src/env.ts. They belong in the deploy, not here.
#
# A TITLE's service URL is NOT here. It is a column on the `titles` row, because there is more than
# one title — which is the entire point of this service.
#
# WORLDS_TEST_DATABASE_URL is read only by the test suite, and only when its name contains "test" —
# the database-backed tests truncate.
